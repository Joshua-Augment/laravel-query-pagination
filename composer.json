{
  "name": "augmentmy/laravel-query-pagination",
  "description": "Reusable pagination, filtering, sorting helper for Laravel APIs",
  "type": "library",
  "license": "MIT",
  "require-dev": {
    "orchestra/testbench": "^9.15",
    "phpunit/phpunit": "^12.3"
  },
  "autoload": {
    "psr-4": {
      "AugmentMy\\LaravelQueryPagination\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AugmentMy\\LaravelQueryPagination\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Joshua Samuel",
      "email": "joshua.samuel@my-augment.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "illuminate/pagination": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/database": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "AugmentMy\\LaravelQueryPagination\\LaravelQueryPaginationServiceProvider"
      ]
    }
  }
}
